# Which LLM to use: anthropic | openai | groq | openrouter
# Leave empty to use whichever provider below has a key (none = rules only)
LLM_PROVIDER=
# Optional: override the provider's default model
LLM_MODEL=

# Only the key for your chosen provider is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
